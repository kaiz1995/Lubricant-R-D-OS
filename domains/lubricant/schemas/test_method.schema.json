{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubricant-rd.local/schemas/test_method.schema.json",
  "title": "Test method qualification",
  "allOf": [{ "$ref": "common.schema.json#/$defs/artifact" }],
  "type": "object",
  "properties": {
    "artifact_type": { "const": "test_method" },
    "method_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "standard": { "type": "string", "minLength": 1 },
    "target_failure_reference": { "type": "string", "minLength": 1 },
    "role": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["C", "D", "P"] } },
    "qualification_metrics": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": { "metric": { "enum": ["REPEATABILITY", "DISCRIMINATION", "SENSITIVITY", "MECHANISM_RELEVANCE", "BENCHMARK_RANKING", "FIELD_RELEVANCE", "COST", "DURATION"] }, "measurement": { "$ref": "common.schema.json#/$defs/measurement" } },
        "required": ["metric", "measurement"], "additionalProperties": false
      }
    },
    "qualification_basis": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "qualification_status": { "enum": ["PENDING", "QUALIFIED", "NOT_QUALIFIED"] }
  },
  "required": ["artifact_type", "evidence_scope", "method_id", "name", "standard", "target_failure_reference", "role", "qualification_metrics", "qualification_basis", "qualification_status"],
  "unevaluatedProperties": false
}
