{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubricant-rd.local/schemas/failure_ctq.schema.json",
  "title": "Failure and CTQ matrix",
  "allOf": [{ "$ref": "common.schema.json#/$defs/artifact" }],
  "type": "object",
  "properties": {
    "artifact_type": { "const": "failure_ctq" },
    "challenge_reference": { "type": "string", "minLength": 1 },
    "failure_id": { "type": "string", "minLength": 1 },
    "failure_mode": { "type": "string", "minLength": 1 },
    "mechanism": { "type": "string", "minLength": 1 },
    "failure_diagnosis": { "type": "string", "minLength": 1 },
    "root_cause_hypotheses": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "lubricant_contribution": { "type": "string", "minLength": 1 },
    "ctqs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ctq_id": { "type": "string", "minLength": 1 },
          "classification": { "enum": ["CTQ", "DEGRADATION_INDICATOR", "FUNCTIONAL_SYMPTOM"] },
          "observable": { "type": "string", "minLength": 1 },
          "specification_limit": { "$ref": "common.schema.json#/$defs/measurement" },
          "engineering_risk_limit": { "$ref": "common.schema.json#/$defs/measurement" },
          "test_references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "evidence_required": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["ctq_id", "classification", "observable", "specification_limit", "engineering_risk_limit", "test_references", "evidence_required"],
        "additionalProperties": false
      }
    },
    "test_chain": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "required": ["artifact_type", "challenge_reference", "failure_id", "failure_mode", "mechanism", "failure_diagnosis", "root_cause_hypotheses", "lubricant_contribution", "ctqs", "test_chain"],
  "unevaluatedProperties": false
}
