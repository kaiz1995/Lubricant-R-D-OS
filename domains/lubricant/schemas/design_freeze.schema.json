{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubricant-rd.local/schemas/design_freeze.schema.json",
  "title": "Design freeze record",
  "description": "Stage 7 contract. Freeze requires every one of the eight freeze conditions to be satisfied with retained evidence. SYNTHETIC evidence can never freeze a design; the artifact scope is PHYSICAL only. WP-08: the freeze_record may also record the signoff (technical_reviewer / reviewed_at / approver / approved_at / dissent); these are records only, no authority is checked, and the FREEZE state transition precondition is adjudicated by scripts/validate_state_machine.py.",
  "allOf": [{ "$ref": "common.schema.json#/$defs/artifact" }],
  "type": "object",
  "properties": {
    "artifact_type": { "const": "design_freeze" },
    "evidence_scope": { "const": "PHYSICAL" },
    "freeze_record": {
      "type": "object",
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "evidence_package": { "type": "string", "minLength": 1 },
        "evidence_scope": { "const": "PHYSICAL" },
        "evidence_status": { "enum": ["OBSERVED", "ASSUMED", "GAP"] },
        "technical_reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "approver": { "type": "string", "minLength": 1 },
        "approved_at": { "type": "string", "format": "date-time" },
        "dissent": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/dissent_item" } },
        "freeze_conditions": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "description": "MANUFACTURABILITY_ACCEPTABLE must cite the fixed process-window artifact as PROCESS-WINDOW:<window_id> (process.schema.json process_window.evidence_reference), never a free-form record.",
            "properties": {
              "condition_id": {
                "enum": [
                  "CRITICAL_CTQ_SATISFIED",
                  "CRITICAL_RISK_EVIDENCE_SUFFICIENT",
                  "COST_TARGET_MET",
                  "RAW_MATERIAL_SUPPLY_ACCEPTABLE",
                  "MANUFACTURABILITY_ACCEPTABLE",
                  "CRITICAL_BENCHMARK_NO_DEGRADATION",
                  "COMPATIBILITY_PASSED",
                  "RISK_REVIEW_PASSED"
                ]
              },
              "satisfied": { "const": true },
              "evidence_reference": { "type": "string", "minLength": 1 }
            },
            "required": ["condition_id", "satisfied", "evidence_reference"],
            "additionalProperties": false,
            "if": {
              "properties": { "condition_id": { "const": "MANUFACTURABILITY_ACCEPTABLE" } },
              "required": ["condition_id"]
            },
            "then": {
              "properties": { "evidence_reference": { "pattern": "^PROCESS-WINDOW:" } }
            }
          }
        }
      },
      "required": [
        "reason",
        "evidence_package",
        "evidence_scope",
        "evidence_status",
        "freeze_conditions"
      ],
      "additionalProperties": false
    }
  },
  "required": ["artifact_type", "evidence_scope", "freeze_record"],
  "unevaluatedProperties": false
}
