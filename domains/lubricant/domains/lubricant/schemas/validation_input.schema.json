{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubricant-rd.local/domains/lubricant/schemas/validation_input.schema.json",
  "version": "1.0.0",
  "title": "Validation request",
  "type": "object",
  "properties": {
    "input_type": {"const": "VALIDATION_REQUEST"},
    "artifact": {
      "type": "object",
      "properties": {
        "artifact_type": {"enum": ["cost_result", "doe_result", "statistics_result", "optimization_result"]},
        "data": {"type": "object"}
      },
      "required": ["artifact_type", "data"],
      "additionalProperties": false
    },
    "chain_context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "artifact_type": {"type": "string", "minLength": 1},
          "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "data": {"type": "object"}
        },
        "required": ["artifact_type", "digest", "data"],
        "additionalProperties": false
      }
    }
  },
  "required": ["input_type", "artifact"],
  "additionalProperties": false
}
