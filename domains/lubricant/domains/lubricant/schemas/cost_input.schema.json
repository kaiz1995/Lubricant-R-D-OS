{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubricant-rd.local/domains/lubricant/schemas/cost_input.schema.json",
  "title": "Cost input",
  "type": "object",
  "properties": {
    "input_type": {
      "const": "COST_CALCULATION"
    },
    "formula": {
      "type": "object",
      "properties": {
        "formula_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "material_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
              },
              "fraction": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "material_id",
              "fraction"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "formula_id",
        "version",
        "components"
      ],
      "additionalProperties": false
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "material_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "enum": [
              "BASE_OIL",
              "ADDITIVE",
              "THICKENER",
              "OTHER"
            ]
          },
          "supplier": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "const": "CNY_PER_KG"
          },
          "price": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "currency": {
            "const": "CNY"
          },
          "effective_date": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "material_id",
          "name",
          "category",
          "unit",
          "price",
          "currency",
          "effective_date"
        ],
        "additionalProperties": false
      }
    },
    "price_timestamp": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "input_type",
    "formula",
    "materials",
    "price_timestamp"
  ],
  "additionalProperties": false
}
