{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubricant-rd.local/domains/lubricant/schemas/doe_input.schema.json",
  "title": "DOE input",
  "type": "object",
  "properties": {
    "input_type": { "enum": ["MIXTURE_DOE_DESIGN", "FACTORIAL_DOE_DESIGN", "MIXTURE_PROCESS_DOE_DESIGN"] },
    "design_space_reference": { "type": "string", "minLength": 1 },
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "component_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "lower_bound": { "type": "number", "minimum": 0, "maximum": 1 },
          "upper_bound": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["component_id", "lower_bound", "upper_bound"],
        "additionalProperties": false
      }
    },
    "mixture_total": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
    "factors": {
      "description": "Independent (not mixture-closed) design dimensions. WP-04a supports two-level factors only: a factor varies between exactly two levels (explicit levels[] or a range[low,high]) or is held constant at hold_at and contributes no column. role records the split-plot structure: WHOLE_PLOT factors are hard to change, SUB_PLOT factors are reset per run. This role is orthogonal to design_space.constraint_role.",
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "properties": {
          "factor_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "factor_type": { "enum": ["CONTINUOUS", "DISCRETE"] },
          "role": { "enum": ["WHOLE_PLOT", "SUB_PLOT"] },
          "levels": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }, "uniqueItems": true },
          "range": {
            "type": "object",
            "properties": { "lower": { "type": "number" }, "upper": { "type": "number" } },
            "required": ["lower", "upper"],
            "additionalProperties": false
          },
          "hold_at": { "type": "number" },
          "unit": { "type": "string", "minLength": 1 }
        },
        "required": ["factor_id", "factor_type", "role"],
        "additionalProperties": false,
        "oneOf": [
          { "required": ["levels"], "properties": { "range": false, "hold_at": false } },
          { "required": ["range"], "properties": { "levels": false, "hold_at": false } },
          { "required": ["hold_at"], "properties": { "levels": false, "range": false } }
        ]
      }
    },
    "whole_plot_replicates": { "type": "integer", "minimum": 1 },
    "design_type": { "enum": ["SIMPLEX_MIXTURE", "D_OPTIMAL_MIXTURE", "FULL_FACTORIAL", "FRACTIONAL_FACTORIAL", "SPLIT_PLOT", "TAGUCHI_ROBUST"] },
    "model_order": { "enum": ["LINEAR", "QUADRATIC"] },
    "target_runs": { "type": "integer", "minimum": 0 },
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "ctq_reference": { "type": "string", "minLength": 1 },
          "test_method_reference": { "type": "string", "minLength": 1 },
          "role": { "enum": ["OPTIMIZATION_RESPONSE", "GUARDRAIL", "DIAGNOSTIC_RESPONSE"] }
        },
        "required": ["ctq_reference", "test_method_reference", "role"],
        "additionalProperties": false
      }
    },
    "experiment_card": {
      "type": "object",
      "properties": {
        "decision_question": { "type": "string", "minLength": 1 },
        "hypothesis": { "type": "string", "minLength": 1 },
        "variables_note": { "type": "string", "minLength": 1 },
        "constraints_note": { "type": "string", "minLength": 1 },
        "responses_note": { "type": "string", "minLength": 1 },
        "doe_selection_reason": { "type": "string", "minLength": 1 },
        "expected_information_value": { "type": "string", "minLength": 1 },
        "decision_rule": { "type": "string", "minLength": 1 }
      },
      "required": ["decision_question", "hypothesis", "variables_note", "constraints_note", "responses_note", "doe_selection_reason", "expected_information_value", "decision_rule"],
      "additionalProperties": false
    }
  },
  "required": ["input_type", "design_type", "model_order", "target_runs", "responses", "experiment_card"],
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "input_type": { "const": "MIXTURE_DOE_DESIGN" } }, "required": ["input_type"] },
      "then": {
        "required": ["components", "mixture_total"],
        "properties": { "factors": false, "whole_plot_replicates": false }
      }
    },
    {
      "if": { "properties": { "input_type": { "const": "FACTORIAL_DOE_DESIGN" } }, "required": ["input_type"] },
      "then": {
        "required": ["factors", "design_space_reference"],
        "properties": { "components": false, "mixture_total": false }
      }
    },
    {
      "if": { "properties": { "input_type": { "const": "MIXTURE_PROCESS_DOE_DESIGN" } }, "required": ["input_type"] },
      "then": { "required": ["components", "mixture_total", "factors", "design_space_reference"] }
    }
  ]
}
