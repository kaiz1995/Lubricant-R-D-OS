{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubricant-rd.local/domains/lubricant/schemas/doe_result_schema.json",
  "title": "DOE result",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "engine_name": {
      "const": "doe"
    },
    "engine_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "OK",
        "REJECTED"
      ]
    },
    "rejection_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_question": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "decision_rule": {
      "type": "string",
      "minLength": 1
    },
    "expected_information_value": {
      "type": "string",
      "minLength": 1
    },
    "variables_note": {
      "type": "string",
      "minLength": 1
    },
    "constraints_note": {
      "type": "string",
      "minLength": 1
    },
    "responses_note": {
      "type": "string",
      "minLength": 1
    },
    "doe_selection_reason": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "OBSERVED",
              "ASSUMED",
              "GAP"
            ]
          }
        },
        "required": [
          "evidence_id",
          "statement",
          "source",
          "status"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "engine_name",
    "engine_version",
    "method",
    "parameters",
    "input_digest",
    "status",
    "rejection_reasons",
    "result",
    "evidence"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "REJECTED"
          }
        }
      },
      "then": {
        "properties": {
          "rejection_reasons": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "rejection_reasons": {
            "maxItems": 0
          },
          "result": {
            "type": "object",
            "oneOf": [
              {
                "title": "Mixture result (unchanged Phase 4.2 shape)",
                "type": "object",
                "properties": {
                  "design_type": {
                    "enum": [
                      "SIMPLEX_MIXTURE",
                      "D_OPTIMAL_MIXTURE"
                    ]
                  },
                  "model_order": {
                    "enum": [
                      "LINEAR",
                      "QUADRATIC"
                    ]
                  },
                  "runs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "run_index": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "proportions": {
                          "type": "object",
                          "minProperties": 1,
                          "propertyNames": {
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                          },
                          "additionalProperties": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1
                          }
                        }
                      },
                      "required": [
                        "run_index",
                        "proportions"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "run_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "candidates_considered": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "selection_reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "design_type",
                  "model_order",
                  "runs",
                  "run_count",
                  "candidates_considered",
                  "selection_reason"
                ],
                "additionalProperties": false
              },
              {
                "title": "Factorial / split-plot result (WP-04a): factor settings, effect columns and whole/sub-plot error terms",
                "type": "object",
                "properties": {
                  "design_type": {
                    "enum": [
                      "FULL_FACTORIAL",
                      "FRACTIONAL_FACTORIAL",
                      "SPLIT_PLOT",
                      "TAGUCHI_ROBUST",
                      "BAYESIAN_SEQUENTIAL"
                    ]
                  },
                  "model_order": {
                    "enum": [
                      "LINEAR",
                      "QUADRATIC"
                    ]
                  },
                  "runs": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "run_index": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "settings": {
                          "type": "object",
                          "minProperties": 1,
                          "propertyNames": {
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                          },
                          "additionalProperties": {
                            "type": "number"
                          }
                        },
                        "whole_plot_index": {
                          "type": "integer",
                          "minimum": 1
                        },
                        "fixed_proportions": {
                          "description": "MIXTURE_PROCESS_DOE_DESIGN only: the frozen formulation proportions carried by every run.",
                          "type": "object",
                          "minProperties": 1,
                          "propertyNames": {
                            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                          },
                          "additionalProperties": {
                            "type": "number"
                          }
                        }
                      },
                      "required": [
                        "run_index",
                        "settings"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "run_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "columns": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "column_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "kind": {
                          "enum": [
                            "MAIN_EFFECT",
                            "INTERACTION"
                          ]
                        },
                        "factors": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "coded_levels": {
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "enum": [
                              -1,
                              1
                            ]
                          }
                        },
                        "aliases": {
                          "description": "Effects sharing this exact contrast vector (fractional factorials); omitted for full factorials.",
                          "type": "array",
                          "minItems": 1,
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "column_id",
                        "kind",
                        "factors",
                        "coded_levels"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "error_terms": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "term_id": {
                          "type": "string",
                          "minLength": 1
                        },
                        "scope": {
                          "enum": [
                            "WHOLE_PLOT",
                            "SUB_PLOT",
                            "PLOT"
                          ]
                        },
                        "degrees_of_freedom": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "source": {
                          "enum": [
                            "RESIDUAL",
                            "BLOCK"
                          ]
                        },
                        "pooling": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "term_id",
                        "scope",
                        "degrees_of_freedom",
                        "source"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "degrees_of_freedom": {
                    "type": "object",
                    "properties": {
                      "total": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "replicate": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "model": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "error": {
                        "type": "integer",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "total",
                      "replicate",
                      "model",
                      "error"
                    ],
                    "additionalProperties": false
                  },
                  "selection_reason": {
                    "type": "string",
                    "minLength": 1
                  },
                  "resource_feasible": {
                    "description": "WP-04b: true when the whole design fits the supplied resource_envelope (at least one bench slot and run_count <= lot_capacity). Omitted entirely when the input carries no resource_envelope, so pre-WP-04b envelopes stay byte-identical.",
                    "type": "boolean"
                  },
                  "information_gain_per_slot": {
                    "description": "WP-04b: total information gain of the recommended batch divided by the bench slots it consumes. Bench slot = one run.",
                    "type": "number"
                  },
                  "recommended_next_runs": {
                    "description": "WP-04b: the next round the resource envelope allows, ranked by information gain per bench slot. Each entry carries the hypothesis it discriminates and why.",
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "properties": {
                        "rank": { "type": "integer", "minimum": 1 },
                        "hypothesis_reference": { "type": "string", "minLength": 1 },
                        "hypothesis_statement": { "type": "string", "minLength": 1 },
                        "effect_reference": { "type": "string", "minLength": 1 },
                        "run_index": {
                          "description": "Index into runs[] of the run that resolves this hypothesis, or null when no run in the current batch sets every factor of the effect to its high level - the recommendation is then one extra run at the all-high corner given by settings.",
                          "type": ["integer", "null"]
                        },
                        "settings": {
                          "type": "object",
                          "minProperties": 1,
                          "propertyNames": { "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                          "additionalProperties": { "type": "number" }
                        },
                        "whole_plot_index": { "type": "integer", "minimum": 1 },
                        "slots_used": { "type": "integer", "minimum": 1 },
                        "information_gain_per_slot": { "type": "number" },
                        "discriminative_power_reason": { "type": "string", "minLength": 1 }
                      },
                      "required": [
                        "rank",
                        "hypothesis_reference",
                        "hypothesis_statement",
                        "effect_reference",
                        "run_index",
                        "settings",
                        "slots_used",
                        "information_gain_per_slot",
                        "discriminative_power_reason"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "design_type",
                  "model_order",
                  "runs",
                  "run_count",
                  "columns",
                  "error_terms",
                  "degrees_of_freedom",
                  "selection_reason"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "decision_question",
          "hypothesis",
          "decision_rule",
          "expected_information_value",
          "variables_note",
          "constraints_note",
          "responses_note",
          "doe_selection_reason"
        ]
      }
    }
  ]
}
