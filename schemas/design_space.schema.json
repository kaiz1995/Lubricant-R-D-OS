{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubricant-rd.local/schemas/design_space.schema.json",
  "title": "Constrained design space",
  "allOf": [{ "$ref": "common.schema.json#/$defs/artifact" }],
  "type": "object",
  "properties": {
    "artifact_type": { "const": "design_space" },
    "design_space_id": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "variables": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "variable_id": { "type": "string", "minLength": 1 },
          "variable_type": { "enum": ["MATERIAL_FAMILY", "FORMULATION_VARIABLE", "PROCESS_VARIABLE"] },
          "lower_bound": { "$ref": "common.schema.json#/$defs/measurement" },
          "upper_bound": { "$ref": "common.schema.json#/$defs/measurement" },
          "constraint_rationale": { "type": "string", "minLength": 1 }
        },
        "required": ["variable_id", "variable_type", "lower_bound", "upper_bound", "constraint_rationale"],
        "additionalProperties": false
      }
    },
    "ctq_references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "qualified_test_method_references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "required": ["artifact_type", "design_space_id", "scope", "variables", "ctq_references", "qualified_test_method_references", "constraints"],
  "unevaluatedProperties": false
}
