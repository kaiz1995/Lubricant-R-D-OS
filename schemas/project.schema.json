{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lubricant-rd.local/schemas/project.schema.json",
  "title": "Project charter",
  "allOf": [{ "$ref": "common.schema.json#/$defs/artifact" }],
  "type": "object",
  "properties": {
    "artifact_type": { "const": "project" },
    "status": { "enum": ["DRAFT", "ACTIVE", "HOLD", "PIVOTED", "KILLED", "FROZEN", "CLOSED"] },
    "project_name": { "type": "string", "minLength": 1 },
    "project_type": { "enum": ["NEW_PRODUCT", "COST_DOWN", "IMPROVEMENT", "CORRECTIVE_ACTION"] },
    "product_family": { "type": "string", "minLength": 1 },
    "business_objective": { "type": "string", "minLength": 1 },
    "technical_objective": { "type": "string", "minLength": 1 },
    "hard_constraints": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "target_cost": { "$ref": "common.schema.json#/$defs/measurement" },
    "benchmark_products": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "success_criteria": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "risk_class": { "enum": ["LOW", "MEDIUM", "HIGH", "STRATEGIC"] },
    "owner": { "type": "string", "minLength": 1 }
  },
  "required": ["artifact_type", "status", "project_name", "project_type", "product_family", "business_objective", "technical_objective", "hard_constraints", "target_cost", "benchmark_products", "success_criteria", "risk_class", "owner"],
  "unevaluatedProperties": false
}
